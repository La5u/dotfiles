#!/usr/bin/env bash
# Re-pick the laptop panel's refresh rate when the charger is plugged or unplugged.
# The rates are chosen by set_refresh_rate() in hypr/hyprland.lua.
grep -sqx Battery /sys/class/power_supply/*/type || exit 0

last=""
udevadm monitor --udev --subsystem-match=power_supply | while read -r _; do
    now=$(grep -sx Discharging /sys/class/power_supply/*/status)
    [[ $now == "$last" ]] && continue
    last=$now
    hyprctl eval 'set_refresh_rate()' >/dev/null
done
