#!/usr/bin/env bash
# Switch the display refresh rate when the charger is plugged or unplugged.
# The rates live in set_refresh_rate() in hypr/hosts/aarch64.lua.
[[ -r /sys/class/power_supply/macsmc-ac/online ]] || exit 0

udevadm monitor --udev --subsystem-match=power_supply | while read -r line; do
    [[ $line == *macsmc-ac* ]] && hyprctl eval 'set_refresh_rate()' >/dev/null
done
