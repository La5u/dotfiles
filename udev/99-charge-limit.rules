# Stop charging at 80% to slow battery wear (Apple Silicon, macsmc driver).
# For a full charge before a trip: echo 100 | sudo tee /sys/class/power_supply/macsmc-battery/charge_control_end_threshold
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="macsmc-battery", ATTR{charge_control_end_threshold}="80"
