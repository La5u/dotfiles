# Stop charging at 80% to slow battery wear, on any laptop whose driver supports it.
# For a full charge before a trip (until next boot):
#   echo 100 | sudo tee /sys/class/power_supply/*/charge_control_end_threshold
ACTION=="add", SUBSYSTEM=="power_supply", ATTR{type}=="Battery", TEST=="charge_control_end_threshold", ATTR{charge_control_end_threshold}="80"
